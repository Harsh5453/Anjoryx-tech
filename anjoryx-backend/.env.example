# Copy relevant values into real environment variables (or a local .env
# loaded by your process manager) for local development.
# NEVER commit real credentials to Git.

# --- Server ---
SERVER_PORT=8080

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/anjoryx_db?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
DDL_AUTO=update
SHOW_SQL=false

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (Spring Boot Mail) ---
# Leave MAIL_ENABLED=false (or unset) to run safely without email configured;
# enquiries are logged instead of emailed.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@anjoryx.com
CONTACT_EMAIL=anjoryx.tech@gmail.com

# --- Rate limiting (contact endpoint) ---
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10

# --- Logging ---
LOG_LEVEL=INFO
